# Copy to .env (gitignored), fill in, then run:
#   dart run build_runner build --delete-conflicting-outputs
#
# Supabase: the hosted project's URL and publishable key, or the values that
# `supabase start` prints for a local stack (use http://10.0.2.2:54321 from the
# Android emulator).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Mapbox: the app token (public, map drawing only). See
# brodie-supabase/docs/mapbox-usage.md.
MAPBOX_ACCESS_TOKEN=
